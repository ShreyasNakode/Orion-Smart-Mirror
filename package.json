{
    "name":  "orion_smart-mirror_3",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx server.ts",
                    "build":  "vite build \u0026\u0026 esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
                    "start":  "node dist/server.cjs",
                    "preview":  "vite preview",
                    "clean":  "node -e \"const fs=require(\u0027fs\u0027); [\u0027dist\u0027,\u0027release\u0027].forEach(p=\u003efs.rmSync(p,{recursive:true,force:true}))\"",
                    "lint":  "tsc --noEmit",
                    "desktop":  "npm run build \u0026\u0026 electron .",
                    "package:win":  "npm run build \u0026\u0026 electron-builder --win --x64 \u0026\u0026 node scripts/copy-desktop-env.cjs"
                },
    "dependencies":  {
                         "@google/genai":  "^2.9.0",
                         "@tailwindcss/vite":  "^4.1.14",
                         "@types/qrcode":  "^1.5.6",
                         "@vitejs/plugin-react":  "^5.0.4",
                         "clsx":  "^2.1.1",
                         "cors":  "^2.8.6",
                         "dotenv":  "^17.2.3",
                         "express":  "^4.21.2",
                         "firebase":  "^12.15.0",
                         "home-assistant-js-websocket":  "^9.6.0",
                         "localforage":  "^1.10.0",
                         "lucide-react":  "^0.546.0",
                         "motion":  "^12.23.24",
                         "qrcode":  "^1.5.4",
                         "react":  "^19.0.1",
                         "react-dom":  "^19.0.1",
                         "recharts":  "^3.8.1",
                         "socket.io-client":  "^4.8.3",
                         "tailwind-merge":  "^3.6.0",
                         "vite":  "^6.2.3"
                     },
    "devDependencies":  {
                            "@types/express":  "^4.17.21",
                            "@types/node":  "^22.14.0",
                            "@types/react":  "^19.2.18",
                            "@types/react-dom":  "^19.2.5",
                            "autoprefixer":  "^10.4.21",
                            "electron":  "^37.2.6",
                            "electron-builder":  "^26.0.12",
                            "esbuild":  "^0.25.0",
                            "tailwindcss":  "^4.1.14",
                            "tsx":  "^4.21.0",
                            "typescript":  "~5.8.2",
                            "vite":  "^6.2.3"
                        },
    "main":  "electron/main.cjs",
    "build":  {
                  "appId":  "com.orion.smartmirror3",
                  "productName":  "Orion Smart Mirror 3",
                  "directories":  {
                                      "output":  "release"
                                  },
                  "files":  [
                                "dist/**/*",
                                "electron/**/*",
                                "firebase-applet-config.json",
                                "package.json",
                                "node_modules/**/*"
                            ],
                  "win":  {
                              "target":  [
                                             "dir"
                                         ]
                          }
              }
}
