# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=http://localhost:3001

# Spotify Web API credentials. For the desktop app, add this redirect URI in
# your Spotify developer dashboard:
# http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET

# Optional local desktop port.
ORION_PORT=3001

# Must exactly match the redirect URI configured in the Spotify developer dashboard.
SPOTIFY_REDIRECT_URI=http://localhost:3001/api/spotify/callback

# Optional realtime news providers. Orion tries NEWS_API_KEY first, then GNEWS_API_KEY,
# then falls back to Google News RSS when no key is configured.
NEWS_API_KEY=YOUR_NEWS_API_KEY
GNEWS_API_KEY=YOUR_GNEWS_API_KEY

# YouCam Beauty AI Skin Analysis API Key (MCP Server Authentication)
# Obtain your key from the Perfect Corp Developer Console (https://yce.perfectcorp.com/api-console)
YOUCAM_API_KEY=YOUR_YOUCAM_API_KEY

